{
  "version": 2,
  "headers": [
    {
      "source": "/studio",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/studio/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/start",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/start.html",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/studio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/extra/wget/ballengine.app/index.html"
    },
    {
      "source": "/studio",
      "destination": "/studio/index.html"
    },
    {
      "source": "/studio/",
      "destination": "/studio/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/extra/wget/ballengine.app/:path*"
    }
  ]
}
