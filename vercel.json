{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node ../../../scripts/build-static.cjs",
  "outputDirectory": ".",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/start",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/start.html",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/signup",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/signup.html",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/studio",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/studio",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/studio",
      "destination": "/studio.html"
    },
    {
      "source": "/studio/",
      "destination": "/studio.html"
    }
  ],
  "headers": [
    {
      "source": "/studio",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/studio.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
